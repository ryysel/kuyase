#!/bin/sh
# Start an optional YAM v0.2+ / Luna stack installed on the persistent /data disk.
# Rendered into the guest image as /etc/init.d/S99kuyase-yam. Does nothing
# unless /data/yam/bin/yam-run or /data/yam/bin/luna exists, so stock images stay untouched.
if [ -x /data/yam/bin/yam-run ] && [ ! -e /usr/bin/yam ]; then
  ln -sfn /data/yam/bin/yam-run /usr/bin/yam 2>/dev/null || true
fi

[ -x /data/yam/bin/luna ] || exit 0

# The native-volume stub must be up before AirPlay writes volume through the
# station-volume launcher. It is a passive listener; the busy `native-volume
# watch` would eat a whole vCPU under TCG.
if [ -x /data/volume-stub ] && ! pidof volume-stub >/dev/null 2>&1; then
  nohup /data/volume-stub >/tmp/volume-stub.log 2>&1 &
fi

mkdir -p /tmp/yam /data/yam/var/luna/data
touch /data/yam/yam.lock

# Luna's own boot auto-start runs while its HTTP API is not yet answering, so
# plugins that call back into Luna time out. Start Luna with an empty service
# list, then bring the services that were enabled before the reboot back once
# the API is responsive. The list is preserved so a package installed and
# enabled on the bench survives a reboot exactly like on a real speaker.
#
# Do NOT auto-start station.volume: `native-volume watch` busy-loops in the
# emulator, eats a whole vCPU and starves Luna's HTTP API.
state=/data/yam/var/luna/data/plugins/services.json
saved_services=
if [ -f "$state" ]; then
  saved_services=$(sed -n 's/^[[:space:]]*"\([^"]*\)".*/\1/p' "$state" 2>/dev/null | tr '\n' ' ')
fi
if [ -d /data/yam/var/luna/data/plugins ]; then
  printf '[]\n' > "$state"
fi

if ! pidof luna >/dev/null 2>&1; then
  nohup /data/yam/bin/luna --listen 0.0.0.0:8099 --data-dir /data/yam/var/luna/data \
    >>/data/yam/var/luna/luna.log 2>&1 &
fi

# Wait up to 30s for Luna's HTTP API on :8099
i=0
while [ "$i" -lt 30 ]; do
  if wget -qO- http://127.0.0.1:8099/api/device >/dev/null 2>&1; then
    break
  fi
  i=$((i + 1))
  sleep 1
done

# Re-enable everything that was enabled before the reboot. station.airplay
# has its own start logic below.
if [ -x /data/luna-ctl ] && [ -n "$saved_services" ]; then
  /data/luna-ctl wait || true
  for id in $saved_services; do
    case "$id" in
      station.airplay) continue ;;
    esac
    /data/luna-ctl enable "$id" >/dev/null 2>&1 || true
  done
fi

if [ -x /data/luna-ctl ]; then
  /data/luna-ctl wait || exit 0

  airplay_up() {
    /data/luna-ctl running station.airplay >/dev/null 2>&1 \
      && netstat -ltn 2>/dev/null | grep -qE ':(5000|7000)'
  }

  # A cold AirPlay start (private D-Bus, Avahi, nqptp, shairport-sync) needs
  # close to a minute under TCG. Re-enabling during that window kills the
  # plugin mid-start, so wait for the RTSP port first and only re-enable when
  # the plugin process is really gone. Total budget: 3 attempts x 2 minutes.
  attempt=0
  while ! airplay_up && [ "$attempt" -lt 3 ]; do
    /data/luna-ctl running station.airplay >/dev/null 2>&1 \
      || /data/luna-ctl enable station.airplay >/dev/null 2>&1 || true
    i=0
    while [ "$i" -lt 24 ] && ! airplay_up; do
      /data/luna-ctl running station.airplay >/dev/null 2>&1 || break
      i=$((i + 1))
      sleep 5
    done
    attempt=$((attempt + 1))
    sleep 3
  done

  # Self-heal: only restart AirPlay when the plugin is actually dead. Checking
  # the RTSP port would kill a slow but healthy startup.
  (
    while :; do
      sleep 20
      /data/luna-ctl running station.airplay >/dev/null 2>&1
      if [ $? -eq 1 ]; then
        /data/luna-ctl enable station.airplay >/dev/null 2>&1 || true
      fi
    done
  ) &
fi
